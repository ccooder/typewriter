<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="typewriter">
	<schema id="run.fenglu.typewriter" path="/run/fenglu/typewriter/">
		<key name="window-width" type="i">
			<default>800</default>
			<summary>窗口宽度</summary>
		</key>
		<key name="window-height" type="i">
			<default>600</default>
			<summary>窗口高度</summary>
		</key>
		<key name="window-maximized" type="b">
			<default>false</default>
			<summary>窗口是否最大化</summary>
		</key>
		<key name="ctrl-enter-send" type="b">
			<default>false</default>
			<summary>QQ发送键是否为Ctrl+Enter（否则为Enter）</summary>
		</key>
		<key name="ime-name" type="s">
			<default>""</default>
			<summary>成绩单显示的输入法名，留空则自动探测输入法框架</summary>
		</key>
	</schema>
</schemalist>
